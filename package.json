{
  "name": "css-frameworks-ca",
  "version": "1.0.0",
  "description": "Test",
  "main": "index.js",
  "scripts": {
    "build": "sass src/scss:dist/css",
    "start": "concurrently \"sass --watch src/scss:dist/css\" \"live-server --port=3000\"",
    "prepare": "npx husky install",
    "lint": "eslint .",
    "test:unit": "jest",
    "test": "npm run test:unit",
    "test:e2e": "cypress open",
    "test:e2e:ci": "cypress run --headless"
  },
  "keywords": [],
  "author": "Noroff",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "cypress": "^12.17.4",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-cypress": "^4.2.1",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "live-server": "^1.2.2",
    "prettier": "^3.5.3",
    "sass": "^1.54.8"
  },
  "dependencies": {
    "bootstrap-dark-5": "^1.1.3",
    "dotenv": "^16.5.0"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.html": [
      "prettier --write"
    ]
  }
}